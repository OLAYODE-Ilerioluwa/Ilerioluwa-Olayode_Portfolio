rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== PLATS (menu) =====
    // Lecture publique (le menu s'affiche pour tous).
    // Écriture réservée à l'administrateur connecté.
    match /plats/{platId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ===== RESERVATIONS =====
    // Personne ne peut LIRE les réservations sauf l'admin connecté
    // (noms + emails = données personnelles à protéger).
    // Un client peut en CRÉER une (sans compte), mais la donnée est validée.
    match /reservations/{resaId} {
      allow read, update, delete: if request.auth != null;
      allow create: if reservationValide();
    }

    // ===== AVIS =====
    // Lecture publique, création publique (validée), modération par l'admin.
    match /avis/{avisId} {
      allow read: if true;
      allow create: if avisValide();
      allow update, delete: if request.auth != null;
    }

    // --- Fonctions de validation ---

    function reservationValide() {
      let d = request.resource.data;
      return d.keys().hasOnly(['prenom', 'nom', 'email', 'date', 'heure', 'personnes', 'createdAt'])
        && d.prenom is string && d.prenom.size() > 0 && d.prenom.size() <= 60
        && d.nom is string && d.nom.size() > 0 && d.nom.size() <= 60
        && d.email is string && d.email.size() <= 120 && d.email.matches('.+@.+[.].+')
        && d.date is string && d.date.size() <= 20
        && d.heure is string && d.heure.size() <= 10
        && d.personnes is int && d.personnes >= 1 && d.personnes <= 20
        && d.createdAt is timestamp;
    }

    function avisValide() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nom', 'texte', 'note', 'date'])
        && d.nom is string && d.nom.size() > 0 && d.nom.size() <= 60
        && d.texte is string && d.texte.size() > 0 && d.texte.size() <= 1000
        && d.note is int && d.note >= 1 && d.note <= 5;
    }
  }
}
